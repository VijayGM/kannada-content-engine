import unittest
import unicodedata

from scripts.lib.kannada_text import sanitize_and_validate, sanitize_kannada


class KannadaTextTests(unittest.TestCase):
    def test_normal_kannada_is_preserved(self):
        text = "ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ ಕನ್ನಡ ಸರಿಯಾಗಿ ಕಾಣಬೇಕು."
        self.assertEqual(sanitize_kannada(text), unicodedata.normalize("NFC", text))
        sanitize_and_validate(text)

    def test_zwj_and_zwj_sequences_are_not_replaced(self):
        # ZWJ is a valid format character for complex-script shaping.
        text = "ಕನ್ನಡ\u200dಪರೀಕ್ಷೆ"
        cleaned = sanitize_kannada(text)
        self.assertIn("\u200d", cleaned)
        self.assertNotIn("\ufffd", cleaned)

    def test_zwnj_is_not_replaced(self):
        text = "ಕನ್ನಡ\u200cಪರೀಕ್ಷೆ"
        cleaned = sanitize_kannada(text)
        self.assertIn("\u200c", cleaned)
        self.assertNotIn("\ufffd", cleaned)

    def test_code_mixing_and_symbols_are_preserved(self):
        text = "ಇದು Kannada + ₹1,000 — 2026!"
        cleaned = sanitize_and_validate(text)
        self.assertIn("Kannada", cleaned)
        self.assertIn("₹", cleaned)
        self.assertIn("2026", cleaned)

    def test_controls_are_removed_not_replaced(self):
        text = "ಕನ್ನಡ\x00 ಪರೀಕ್ಷೆ"
        cleaned = sanitize_and_validate(text)
        self.assertNotIn("\ufffd", cleaned)
        self.assertNotIn("\x00", cleaned)

    def test_existing_replacement_character_fails(self):
        with self.assertRaises(ValueError):
            sanitize_kannada("ಕನ್ನಡ \ufffd ಪರೀಕ್ಷೆ")

    def test_romanized_kannada_fails_validation(self):
        with self.assertRaises(ValueError):
            sanitize_and_validate("nanna hesaru vijay")

    def test_nfc_normalization(self):
        text = unicodedata.normalize("NFD", "ಕನ್ನಡ ಪರೀಕ್ಷೆ")
        cleaned = sanitize_and_validate(text)
        self.assertEqual(cleaned, unicodedata.normalize("NFC", text))


    def test_ffmpeg_kannada_subtitle_render_smoke(self):
        import shutil
        import subprocess
        import tempfile
        from pathlib import Path

        ffmpeg = shutil.which("ffmpeg")
        fc_match = shutil.which("fc-match")
        if not ffmpeg or not fc_match:
            self.skipTest("ffmpeg/fontconfig is not installed")

        font_result = subprocess.run(
            [fc_match, "-f", "%{file}", "Noto Sans Kannada"],
            capture_output=True, text=True, check=False,
        )
        font_file = font_result.stdout.strip()
        if not font_file or not Path(font_file).is_file():
            self.skipTest("Noto Sans Kannada font is not installed")

        with tempfile.TemporaryDirectory() as tmp:
            tmp = Path(tmp)
            fonts = tmp / "fonts"
            fonts.mkdir()
            shutil.copy2(font_file, fonts / "NotoSansKannada-Regular.ttf")
            ass = tmp / "test.ass"
            out = tmp / "frame.png"

            text = "ಕನ್ನಡ ಪರೀಕ್ಷೆ — ನಿಮ್ಮ ಫೋನ್‌ನಲ್ಲಿ ಸರಿಯಾಗಿ ಕಾಣಬೇಕು."
            ass.write_text(
                "[Script Info]\n"
                "ScriptType: v4.00+\n"
                "PlayResX: 1080\n"
                "PlayResY: 1920\n\n"
                "[V4+ Styles]\n"
                "Format: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\n"
                "Style: Kannada,Noto Sans Kannada,42,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,2,0,2,60,60,150,1\n\n"
                "[Events]\n"
                "Format: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n"
                f"Dialogue: 0,0:00:00.00,0:00:02.00,Kannada,,0,0,0,,{text}\n",
                encoding="utf-8",
            )

            result = subprocess.run(
                [
                    ffmpeg, "-y",
                    "-f", "lavfi", "-i", "color=c=black:s=1080x1920:d=2:r=25",
                    "-vf",
                    f"ass='{ass}':fontsdir='{fonts}':shaping=complex",
                    "-frames:v", "1",
                    str(out),
                ],
                capture_output=True, text=True, check=False,
            )

            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertTrue(out.exists())
            combined = result.stdout + result.stderr
            self.assertIn("HarfBuzz", combined)
            self.assertIn("NotoSansKannada-Regular", combined)


if __name__ == "__main__":
    unittest.main()

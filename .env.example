# Copy this file's keys into GitHub → Settings → Secrets and variables →
# Actions → New repository secret. Never commit a real .env — this repo's
# entire security model relies on secrets living only in GitHub Actions
# Secrets (encrypted at rest), not in code or local files.
# See architecture doc §15 for why there's no local .env in normal use at all.

# Supabase (state store — §16 of the architecture doc)
SUPABASE_URL=
SUPABASE_KEY=              # service_role key — server-side only, never expose client-side

# Gemini (LLM — free tier)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest   # verify current free-tier model name before first run

# Sarvam AI (Kannada TTS — primary, ~Rs1000 signup credit)
SARVAM_API_KEY=
TTS_PROVIDER=sarvam        # switch to indic_tts once the Sarvam credit runs out (see scripts/lib/tts.py)

# Telegram (Human Approval Mode notification channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Instagram Graph API (publishing — requires Meta App Review, see docs/meta-app-review-checklist.md)
IG_BUSINESS_ACCOUNT_ID=
IG_ACCESS_TOKEN=           # long-lived token; expires ~60 days, needs a refresh step (see README)
